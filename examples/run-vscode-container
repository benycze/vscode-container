#!/usr/bin/env bash
CONTAINER_TOOL=$(command -v docker 2>/dev/null || command -v podman 2>/dev/null || echo "docker")
echo "Starting the VS Code container using ${CONTAINER_TOOL} ..."
${CONTAINER_TOOL} run \
--privileged \
--name vscode-dev-$USER \
--interactive --tty --rm \
-p 2222:22 \
-p 8080:80 \
--env="DISPLAY" \
--env "PS1=docker-\w\$ " \
--volume="$HOME/.Xauthority:/root/.Xauthority:rw" \
--volume=$HOME/repos:/project-home \
--volume=$HOME/docker/user-home/ccache:/home/$USER/.ccache \
--volume=$HOME/docker/user-home/vscode-server:/home/$USER/.vscode-server \
--volume=$HOME/docker/user-home/local:/home/$USER/.local \
vscode-devel
