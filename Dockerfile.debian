# #############################################################################
# Configuration
# #############################################################################
# Default base image
ARG DOCKER_BASE_IMAGE=debian:stable
FROM $DOCKER_BASE_IMAGE

# User, password, GID and UID
ARG USER=user
ARG GROUP=user
ARG PW=docker
ARG UID=1002
ARG GID=1002
# Key directory
ARG KEY_DIR
# Number of build jobs
ARG JOBS=4
# Debian package mirror (default: deb.debian.org; presets: cz, cvut, us, il, jp, or custom domain/URL)
ARG DEBIAN_MIRROR=deb.debian.org

# Some diagnostics
RUN echo USER=${USER} GROUP=${GROUP} PW=${PW} UID=${UID} GID=${GID} KEY_DIR=${KEY_DIR} DEBIAN_MIRROR=${DEBIAN_MIRROR}

# #############################################################################
# Image build
# #############################################################################

# Configure closest mirror and enable parallel APT downloads
RUN if [ -n "$DEBIAN_MIRROR" ] && [ "$DEBIAN_MIRROR" != "deb.debian.org" ]; then \
        case "$DEBIAN_MIRROR" in \
            cz|cvut) MIRROR="ftp.cvut.cz" ;; \
            us)      MIRROR="ftp.us.debian.org" ;; \
            il)      MIRROR="ftp.il.debian.org" ;; \
            jp)      MIRROR="ftp.jp.debian.org" ;; \
            *)       MIRROR="$DEBIAN_MIRROR" ;; \
        esac; \
        echo "Configuring Debian mirror: ${MIRROR}"; \
        for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
            if [ -f "$f" ]; then \
                if echo "$MIRROR" | grep -q "://"; then \
                    M_URL="${MIRROR%/}/"; \
                    sed -i "s|http://deb.debian.org/debian/|${M_URL}|g; s|http://deb.debian.org/debian|${M_URL%/*}|g" "$f"; \
                else \
                    sed -i "s|deb.debian.org|${MIRROR}|g" "$f"; \
                fi; \
            fi; \
        done; \
    fi && \
    echo 'Acquire::http::Pipeline-Depth "5";' > /etc/apt/apt.conf.d/99parallel

# Install packages
RUN apt update && DEBIAN_FRONTEND=noninteractive apt upgrade -y
RUN DEBIAN_FRONTEND=noninteractive apt install -y \
    apache2 \
    autoconf \
    automake \
    bash-completion \
    bc \
    bison \
    btop \
    build-essential \
    ca-certificates \
    ccache \
    clang \
    cmake \
    device-tree-compiler \
    doxygen \
    doxygen-latex \
    file \
    flex \
    gdb \
    gpg \
    ghostscript \
    git \
    gitk \
    graphviz \
    htop \
    iproute2 \
    libbz2-dev \
    libglib2.0-dev \
    libgmp-dev \
    libhwloc-dev \
    libmath-utils-perl \
    libpcap-dev \
    libpixman-1-dev \
    libssl-dev \
    libthrift-dev \
    libtool \
    locales \
    lsb-release \
    make \
    man-db \
    mc \
    ninja-build \
    openssh-server \
    patch \
    perl* \
    psmisc \
    python3 \
    python3-dev \
    python3-pip \
    rsync \
    sudo \
    tcl \
    texlive-full \
    time \
    vim \
    vim-common \
    vim-gtk3 \
    wget \
    xz-utils \
    zip
RUN apt clean

# Compile nlohmann json library
RUN cd /opt \
    && git clone https://github.com/nlohmann/json \
    && mkdir json/build; cd json \
    && cd build \
    && cmake .. \
    && make -j ${JOBS} \
    && make install \
    && rm -rf /opt/json

# Compile inja
RUN cd /opt \
    && git clone https://github.com/pantor/inja \
    && cd inja \
    && mkdir build \
    && cd build \
    && cmake .. \
    && make -j ${JOBS} \
    && make install \
    && rm -rf /opt/inja

# Setup locale
RUN sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen
ENV LANG en_US.UTF-8
ENV LANGUAGE en_US:en
ENV LC_ALL en_US.UTF-8

# Setup python packages
ARG PYTHON_DEPS="cpplint pylint autopep8 reportlab scapy gitpython dtc"
RUN python3 -m pip install --break-system-packages --no-cache-dir ${PYTHON_DEPS}

# Create a user and setup the password
RUN groupadd -g ${GID} ${GROUP}
RUN useradd -m ${USER} --uid=${UID} --gid=${GID} -s/bin/bash && echo "${USER}:${PW}" | chpasswd

# Configure sudo - create a user & export some variables
RUN echo "${USER} ALL = (root) NOPASSWD:ALL" > /etc/sudoers.d/${USER}
RUN echo "Defaults env_keep += \"DISPLAY\""

# Setup alias for bash users
RUN echo "alias sudo='sudo -E'" >> /etc/bash.bashrc && \
    touch /etc/bashrc && echo "alias sudo='sudo -E'" >> /etc/bashrc

# SSH configuration
# Copy the actual authorized keys (from user HOME) into container
COPY ${KEY_DIR}/authorized_keys /home/${USER}/.ssh/ 
RUN  chmod 700 /home/${USER}/.ssh && \
     chown -R ${USER} /home/${USER}/.ssh && \
     chmod 600 /home/${USER}/.ssh/*

# Copy SSH server keys
COPY ${KEY_DIR}/ssh_host_rsa_key /etc/ssh/
COPY ${KEY_DIR}/ssh_host_rsa_key.pub /etc/ssh/
COPY ${KEY_DIR}/ssh_host_dsa_key /etc/ssh/
COPY ${KEY_DIR}/ssh_host_dsa_key.pub /etc/ssh/
COPY ${KEY_DIR}/ssh_host_ecdsa_key /etc/ssh/
COPY ${KEY_DIR}/ssh_host_ecdsa_key.pub /etc/ssh/
COPY ${KEY_DIR}/ssh_host_ed25519_key /etc/ssh/
COPY ${KEY_DIR}/ssh_host_ed25519_key.pub /etc/ssh/
RUN chown root:root /etc/ssh/ssh_host* && \
    chmod 600 /etc/ssh/ssh_host*

# Copy the start script for the ssh and prepare for autostart
COPY sources/run-ssh /sbin/run-ssh
RUN chmod 755 /sbin/run-ssh
COPY sources/root.bashrc /root/.bashrc

# Copy scripts to /usr/bin and make them executable
COPY scripts/encrypt_sources.py /usr/bin
COPY scripts/install-pandoc.sh /usr/bin
RUN chmod +x /usr/bin/encrypt_sources.py && \
    chmod +x /usr/bin/install-pandoc.sh

# Install pandoc from package
RUN /usr/bin/install-pandoc.sh

EXPOSE 22
